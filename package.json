{
  "name": "action-linear-release-issue",
  "version": "1.3.0",
  "description": "Create Linear issue for GitHub release",
  "author": "Aleksei Tabakman",
  "homepage": "https://github.com/samosad/action-linear-release-issue",
  "private": true,
  "scripts": {
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "package": "npx ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "package:watch": "npm run package -- --watch",
    "release": "release-it",
    "test": "echo \"Error: no test specified\" && exit 1",
    "all": "npm run format:write && npm run package"
  },
  "keywords": [
    "GitHub",
    "Actions",
    "JavaScript",
    "Linear",
    "Release"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@linear/sdk": "^97.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@vercel/ncc": "^0.45.0",
    "prettier": "^3.9.9",
    "release-it": "^21.1.0",
    "typescript": "^6.0.3"
  },
  "type": "module",
  "overrides": {
    "release-it": {
      "undici": "^7.30.0"
    },
    "basic-ftp": "^6.2.2"
  }
}
